# ============================
# KISAAN RAKSHAK CONFIGURATION
# ============================

# ---- AI ASSISTANT (GEMINI) ----
REACT_APP_GEMINI_API_KEY=

# ---- WEATHER INTEGRATION ----
REACT_APP_WEATHER_API_KEY=

# ---- APPLICATION SETTINGS ----
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_ASSISTANT_MODEL=gemini-1.5-flash
REACT_APP_MAX_CHAT_HISTORY=5
REACT_APP_ASSISTANT_TEMPERATURE=0.4

# ---- VOICE SETTINGS ----
REACT_APP_DEFAULT_VOICE_LANG=hi-IN
REACT_APP_FALLBACK_VOICE_LANG=en-IN

# ---- FEATURE FLAGS ----
REACT_APP_ENABLE_VOICE_ASSISTANT=true
REACT_APP_ENABLE_AI_ASSISTANT=true
REACT_APP_ENABLE_WEATHER_CONTEXT=true
REACT_APP_ENABLE_CHAT_PERSISTENCE=true

# ---- PERFORMANCE ----
REACT_APP_API_DEBOUNCE_MS=800
REACT_APP_MAX_TOKENS=800

# ---- FIREBASE ----
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
